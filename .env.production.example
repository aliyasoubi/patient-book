# Production environment for the Ubuntu VPS. Copy to `.env` beside
# compose.prod.yml, fill in every value, then `chmod 600 .env`.
#
# Generate the secrets (DB_PASSWORD, DB_APP_PASSWORD, JWT_SECRET,
# JWT_REFRESH_SECRET) with:
#   openssl rand -base64 48
#
# The API refuses to start in production with placeholder, short, or reused
# secrets, so a half-filled file fails loudly at boot rather than quietly
# running something insecure.

# ── Site ───────────────────────────────────────────────────────────────
# The domain must already resolve to this VPS before the first start:
# Caddy requests a certificate on boot and Let's Encrypt rate-limits failures.
PB_DOMAIN=book.example.com
PB_TLS_EMAIL=admin@example.com

# ── Database ───────────────────────────────────────────────────────────
# Postgres superuser: owns the schema, runs migrations, and is what the
# nightly backup job connects as. The API never uses it — see DB_APP_USER.
DB_USER=dental
DB_NAME=patient_book
# At least 12 characters. Postgres is never published off the internal Docker
# network, but this is also the password the nightly backup job uses.
DB_PASSWORD=

# Least-privilege role the API connects with at runtime: read/write rows,
# no schema changes. `migrate` creates or updates it on every deploy, so
# changing DB_APP_PASSWORD here takes effect on the next deploy.
DB_APP_USER=dental_app
# At least 12 characters, different from DB_PASSWORD.
DB_APP_PASSWORD=

# ── Auth ───────────────────────────────────────────────────────────────
# At least 32 characters each, and the two must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ── Host paths ─────────────────────────────────────────────────────────
# Where the nightly backup job keeps its state on the host. Backups default
# to <PB_HOME_DIR>/PatientBookBackups; set PB_BACKUP_DIR to write them
# somewhere else (an attached volume, a mounted share). This is the only
# place the destination is configured — nothing in the app can change it.
PB_HOME_DIR=/srv/patient-book/home
#PB_BACKUP_DIR=/mnt/backups/patient-book

# ── First administrator (used once, by the seed step) ──────────────────
SEED_ADMIN_USERNAME=admin
# At least 12 characters, and not a placeholder — production seeding rejects
# those. It must be changed again at first login before patient data unlocks.
SEED_ADMIN_PASSWORD=
