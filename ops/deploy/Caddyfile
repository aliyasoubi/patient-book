{
	# Let's Encrypt uses this for expiry warnings. Certificates are issued and
	# renewed automatically; there is no cron job to forget.
	email {$PB_TLS_EMAIL}
}

{$PB_DOMAIN} {
	encode zstd gzip

	# Applied to every response, including the API's.
	header {
		# The practice is HTTPS-only from the first response onward. `preload`
		# is safe here because this domain serves nothing but this app.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

		# Everything the app needs is served from this origin: fonts
		# (vazirmatn, material-symbols) are bundled from node_modules at build
		# time, so no CDN needs to be allowed. `style-src` keeps 'unsafe-inline'
		# because Angular Material writes inline styles at runtime; scripts do
		# not need it, and that is where it would actually matter.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Do not advertise the server or its version.
		-Server
	}

	# The API is same-origin. That is what lets the refresh cookie stay
	# SameSite=Strict and keeps CORS out of the request path entirely.
	handle /api/* {
		# The workbook upload is capped at 8 MB in the controller; stopping a
		# larger body at the edge means it is never buffered by Node at all.
		request_body {
			max_size 12MB
		}
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# Only what Angular builds carries a content hash in its name
		# (`chunk-3KiqRAay.js`, `styles-YEQF2DVG.css`, fonts under media/), and
		# only at those two places, so exactly those may be cached forever. Everything
		# else revalidates: the shell and the translation dictionary, or an open
		# tab keeps running the previous deploy, and the unhashed files from
		# public/ (icons, the front page), or a replaced one never reaches anyone.
		# The two matchers are disjoint so the rule holds after try_files
		# rewrites a deep link to index.html.
		@immutable path_regexp `^/(media/)?[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2|woff|ttf|otf|png|jpg|webp|avif|svg)$`
		@shell not path_regexp `^/(media/)?[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2|woff|ttf|otf|png|jpg|webp|avif|svg)$`
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @shell Cache-Control "no-cache"

		# The public front page, at exactly `/`. Every other path is still the
		# app, so /login, /dashboard and deep links are unchanged.
		rewrite / /landing/index.html

		# Client-side routing: /patients/123 is a route, not a file on disk.
		try_files {path} /index.html
		file_server
	}
}
