# ── Database ───────────────────────────────────────────────
# Override only if Docker Hub is unreachable from this network; any mirror of
# the same official image works, e.g.
#   POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
#POSTGRES_IMAGE=postgres:17-alpine
DB_HOST=localhost
DB_PORT=5432
DB_USER=dental
DB_PASSWORD=dental_dev_pw
DB_NAME=patient_book

# ── API ────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Reverse-proxy hops between the client and this process. Behind a single
# nginx on the same host that is 1, which is the production default; 0 (the
# development default) means the API is reached directly. Getting this wrong
# in either direction matters: too low and the whole practice shares one
# rate-limit bucket while every audit row records the proxy's address, too
# high and a client can forge X-Forwarded-For to walk past the login limit.
#TRUST_PROXY=1

# ── Auth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-48
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change-me-too-different-from-the-access-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Seed admin (created by `npm run seed`) ─────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe!2026
