# Build context hygiene. Secrets and patient data must never reach an image
# layer, and shipping node_modules from a macOS host into a Linux image would
# carry the wrong native binaries.
.git
.github
node_modules
**/node_modules
dist
**/dist
.angular
**/.angular
coverage
**/coverage
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key

# Patient data
data
*.sql
*.dump
*.sql.gz
*.enc

# Host-only tooling
.claude
.idea
.vscode
**/.vscode
*.log
